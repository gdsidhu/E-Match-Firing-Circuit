	)
	(text_box "1. High side current measurement using a hall effect current sensor IC.\n\n2. Sensor output fully isolated from high current path.\n\n3. 100mV increment for each Amp.\n"
		(exclude_from_sim no)
		(at 80.01 72.39 0)
		(size 36.83 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
