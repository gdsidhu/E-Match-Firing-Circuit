		(uuid "f14cf9d6-1409-4f9b-9bcb-9f5b61cdfd3e")
	)
	(text_box "1.Sensor_Output: Analog signal that can easily be converted into current value."
		(exclude_from_sim no)
		(at 191.77 109.22 0)
		(size 19.05 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "294c5aba-d03a-409e-8beb-9a987d4442f8")
	)
	(text_box "1. High side current measurement using a hall effect current sensor IC.\n\n2. Sensor output fully isolated from high current path.\n\n3. 100mV increment for each Amp.\n"
		(exclude_from_sim no)
		(at 125.984 48.26 0)
		(size 36.83 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "29b33d79-3ec9-4ff5-b53e-8ed6adf7f3f9")
	)
	(text_box "1. Trigger_Signal: To actually switch ON or OFF, with the Gate Driver IC enabled, the MOSFET.\n\n2. Enable_Signal: LOW to disable, High to enable outputs of Gate Driver IC."
		(exclude_from_sim no)
		(at 224.028 109.22 0)
		(size 31.75 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a88fe96d-1050-40aa-bd27-0ffda7e3dbc9")
	)
	(text_box "1. To absorb the transient voltage ripple by providing alternate path for current flow during switch off."
		(exclude_from_sim no)
		(at 125.984 90.424 0)
		(size 36.576 11.176)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cad0f51c-ffd9-4dfb-9faf-6e3d6f7db9a8")
	)
	(text_box "1.Enable pins are internally pulled up to High with a 200k resistor so are enabled when floating.\n\n2.Takes in Battery Voltage to switch mosfets faster."
		(exclude_from_sim no)
		(at 125.73 126.492 0)
		(size 36.83 17.018)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f40033e6-0a62-4da4-ae45-1300b0a3537b")
	)
